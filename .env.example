# =========================================
# ARCA — Variables de entorno
# Copia este archivo a .env.local y rellena los valores
# =========================================

# --- Base de datos (Supabase / Postgres) ---
# La APP EN EJECUCIÓN usa el Transaction Pooler (Supavisor, puerto 6543).
# Las MIGRACIONES y tareas administrativas usan la conexión DIRECTA (5432).
#
# Puedes usar cualquiera de estas dos convenciones (ver lib/db/index.ts y
# drizzle.config.ts); no borres las que ya tengas configuradas en Vercel:
#
#   Convención existente del proyecto:
#     DATABASE_URL       -> conexión directa (5432)   [también fallback de app]
#     DATABASE_POOL_URL  -> Transaction Pooler (6543) [usado por la app]
#
#   Convención canónica de Supabase (recomendada para nuevos despliegues):
#     DATABASE_URL       -> Transaction Pooler (6543) [usado por la app]
#     DIRECT_URL         -> conexión directa (5432)   [migraciones/admin]
#
# Conexión directa (migraciones y operaciones administrativas):
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Alias/compatibilidad — conexión directa en la convención existente:
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Transaction Pooler (usado por la app en producción/serverless):
DATABASE_POOL_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- NextAuth.js v5 ---
# Genera con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-en-produccion-usa-un-secreto-aleatorio-de-32-bytes"
AUTH_URL="http://localhost:3000"
# En producción: AUTH_URL="https://atria.app"

# --- Procesos automáticos de Vercel ---
# Genera con: openssl rand -base64 32
CRON_SECRET="cambia-esto-por-un-secreto-aleatorio"

# --- Resend (notificaciones por email) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="ARCA <no-reply@atria.app>"

# --- App ---
NEXT_PUBLIC_APP_NAME="ARCA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MENU_BASE_URL="https://arca.onl"
NEXT_PUBLIC_ARCA_INSTAGRAM_URL="https://www.instagram.com/"
NEXT_PUBLIC_ARCA_FACEBOOK_URL="https://www.facebook.com/"
NEXT_PUBLIC_ARCA_LINKEDIN_URL="https://www.linkedin.com/"

# --- Referidos de vendedores ATRIA ---
# URL del backend de Vendedores ATRIA, por ejemplo https://vendedores-atria.vercel.app/api/backend
VENDEDORES_ATRIA_BACKEND_URL="http://localhost:3001/api/backend"
# Debe coincidir con ATRIA_REFERRAL_WEBHOOK_SECRET en Vendedores ATRIA.
VENDEDORES_ATRIA_WEBHOOK_SECRET="cambia-esto-por-un-secreto-compartido"

# --- Upstash Redis (caché, rate-limiting, idempotencia, locks) ---
# Capa AUXILIAR. La app funciona sin estas variables (cae a PostgreSQL).
# Usa la API REST (compatible con serverless/Vercel), no el cliente TCP.
UPSTASH_REDIS_REST_URL="https://[nombre].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[token-rest]"

# --- Feature flags globales (opcional) ---
# Mantiene el super-admin activo. Email del super-admin (cuenta del dueño del SaaS).
SUPER_ADMIN_EMAIL="ventatormenta@gmail.com"
