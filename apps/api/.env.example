NODE_ENV=development
API_ENABLED=false
PORT=4000

# Postgres. Para Supabase: usa pooler (6543) para DATABASE_URL
# y conexión directa (5432) para DIRECT_URL (migraciones).
DATABASE_URL=postgresql://atria:atria@localhost:5432/atria?schema=public
DIRECT_URL=
# Solo si usas Supabase client (storage, realtime extra)
SUPABASE_URL=
SUPABASE_ANON_KEY=

REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=atria-access-secret-change-me
JWT_REFRESH_SECRET=atria-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
COOKIE_DOMAIN=localhost
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@atria.local
# Resend: preferido sobre SMTP cuando hay API key
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
UPLOAD_MAX_BYTES=10485760
REPORT_EXPORT_PATH=./exports
