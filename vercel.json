{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:migrate && npm run build",
  "regions": ["pdx1"],
  "crons": [
    {
      "path": "/api/cron/gastos-recurrentes",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/expirar-suscripciones",
      "schedule": "0 6 * * *"
    }
  ]
}
